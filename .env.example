# PostgreSQL connection string
DATABASE_URL=postgres://msm:msm@127.0.0.1:5432/msm

# 32+ byte random secret used to sign auth cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-value

# Email of the developer/owner account created on first migration.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me

# OPTIONAL. Without it the admin AI assistant shows as unconfigured and
# every other part of the game continues to work normally.
ANTHROPIC_API_KEY=
