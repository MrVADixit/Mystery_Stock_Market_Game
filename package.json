{
  "name": "mystery-stock-market",
  "version": "1.0.0",
  "private": true,
  "description": "Mystery Stock Market \u2014 a real-time multiplayer market-deduction game.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:engine": "vitest run src/engine",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "test:smoke": "tsx tests/smoke-api.ts",
    "test:acceptance": "tsx tests/acceptance.ts",
    "test:all": "vitest run && tsx tests/smoke-api.ts && tsx tests/acceptance.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "clsx": "2.1.1",
    "dotenv": "^18.0.10",
    "lucide-react": "0.544.0",
    "next": "^15.5.29",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "^3.11.0",
    "tailwind-merge": "3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "22.18.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.5.29",
    "fast-check": "3.23.2",
    "playwright": "^1.63.0",
    "postcss": "^8.5.33",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "^5.1.1"
  }
}
